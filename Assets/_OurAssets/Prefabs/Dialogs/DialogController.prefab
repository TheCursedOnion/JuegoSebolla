  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1505
  indentLevel: 0
  storyText: Ojo, elige con cabeza las tropas. Con el caos los accionistas se largaron
    y la pasta escasea.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
