  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1760
  indentLevel: 0
  storyText: "\xA1Por supuesto! Soy fan total de tu historia."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
