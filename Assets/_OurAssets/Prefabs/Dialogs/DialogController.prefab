  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1761
  indentLevel: 0
  storyText: "\xA1Je, je\u2026! Me agrada tu entusiasmo, forastero."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
