  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1776
  indentLevel: 0
  storyText: "\xA1Vamos colega, esto se pone serio!"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
