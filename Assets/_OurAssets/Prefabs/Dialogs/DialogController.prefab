  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1758
  indentLevel: 0
  storyText: "\xA1Entonces era cierto! Cleopatra\u2026 \xA1t\xFA tambi\xE9n eres
    una resonante!"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
