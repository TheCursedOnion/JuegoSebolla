  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1771
  indentLevel: 0
  storyText: "Mmm\u2026 no deber\xEDa alterar la historia..."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
