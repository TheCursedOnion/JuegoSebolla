  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1507
  indentLevel: 0
  storyText: "Cada unidad cuesta dinero, as\xED que controla tus ansias de comprador
    compulsivo.\n"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
