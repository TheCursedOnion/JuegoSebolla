  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 727
  indentLevel: 0
  storyText: "\xA1\xA1Qu\xE9 pasada!!"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
