--- !u!114 &289460184
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 289459501}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 613
  indentLevel: 0
  storyText: "Si la mayor biblioteca y su reina m\xE1s c\xE9lebre nunca llegan a
    existir en el recuerdo colectivo,  tambi\xE9n se apagar\xE1 la chispa que ha
    encendido tantos ideales que han dado pie a tantas rebeliones."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
