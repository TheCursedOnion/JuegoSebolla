  storyText: "Vale, cuando lo tengas todo bien colocado, le das a \u201CEmpezar\u201D."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
