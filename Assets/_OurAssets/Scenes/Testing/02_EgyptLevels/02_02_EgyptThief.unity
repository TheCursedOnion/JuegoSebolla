  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 193
  indentLevel: 0
  storyText: "En la versi\xF3n original metimos un sistema de pago que, tras el error,
    ahora juega en nuestra contra."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
