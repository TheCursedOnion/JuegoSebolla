  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 614
  indentLevel: 0
  storyText: "Genial\u2026 otra vez recogiendo la basura que dejan los dem\xE1s."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
