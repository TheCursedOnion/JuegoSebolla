  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 212
  indentLevel: 0
  storyText: "Por ejemplo, los soldados b\xE1sicos usan \u201CEnfado\u201D: en su
    siguiente ataque hacen m\xE1s da\xF1o."
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
