  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 62
  indentLevel: 0
  storyText: "Si solo quieres moverte o pasar sin hacer nada, dale aqu\xED y listo:
    pasa al turno de la siguiente tropa."
