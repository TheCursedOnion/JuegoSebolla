  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 19
  indentLevel: 0
  storyText: "As\xED que amigo m\xEDo, nos toca sacar a esa gente de ah\xED dentro."
  description: 
  character: {fileID: 933777898}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
