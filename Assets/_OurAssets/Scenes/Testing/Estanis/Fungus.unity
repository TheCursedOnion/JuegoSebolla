  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 223
  indentLevel: 0
  storyText: "Es l\xF3gico: borrando la mayor biblioteca de la historia y a su figura
    m\xE1s c\xE9lebre, podremos arrancar de ra\xEDz las ideas que han alimentado
    la lucha de clases y de g\xE9nero a lo largo de los siglos."
  description: 
  character: {fileID: 1531481961}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
