  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 24
  indentLevel: 0
  storyText: "Aqu\xED no vas a picar c\xF3digo en C ni en Java. Olv\xEDdate de eso."
  description: 
  character: {fileID: 933777898}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
