  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 221
  indentLevel: 0
  storyText: "Cronos insiste en que con eso se corregir\xE1n los da\xF1os que dejaron
    esos intrusos. Menuda faena\u2026 siempre acabamos arreglando los desastres de
    otros."
  description: 
  character: {fileID: 1034775755}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
