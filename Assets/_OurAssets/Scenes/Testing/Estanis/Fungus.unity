  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 18
  indentLevel: 0
  storyText: "Pero no solo ellos... \xA1Tambi\xE9n han desaparecido personas y monumentos
    ah\xED fuera! \xA1Y todo es un caos!\n"
