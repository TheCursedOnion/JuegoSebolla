  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 220
  indentLevel: 0
  storyText: "Qu\xE9 desperdicio\u2026 la historia nunca deja de devorar a sus hijos.\n"
  description: 
  character: {fileID: 735217361}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
