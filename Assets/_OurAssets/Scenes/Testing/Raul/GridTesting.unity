  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 275
  indentLevel: 0
  storyText: "Vale, cuando lo tengas todo bien colocado, le das a \u201CEmpezar\u201D"
  description: 
  character: {fileID: 605883602}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
