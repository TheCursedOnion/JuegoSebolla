  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 222
  indentLevel: 0
  storyText: 'De acuerdo, Jeanne. '
  description: 
  character: {fileID: 735217361}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
