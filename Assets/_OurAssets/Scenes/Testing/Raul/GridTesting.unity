  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 273
  indentLevel: 0
  storyText: "Y oye\u2026 \xBFa d\xF3nde ir\xE1 todo ese dinero?"
  description: 
  character: {fileID: 605883602}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
