  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 168
  indentLevel: 0
  storyText: "Por un lado tenemos a los m\xE9dicos. No destacan en ataque, pero su
    habilidad \u201CCurar\u201D restaura los puntos de vida (HP) de tus aliados."
  description: 
  character: {fileID: 605883602}
