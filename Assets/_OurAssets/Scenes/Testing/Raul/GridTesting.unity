  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 274
  indentLevel: 0
  storyText: "\xA1Ah, y con la goma de borrar puedes quitar tropas si no te mola
    la alineaci\xF3n!"
  description: 
  character: {fileID: 605883602}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
